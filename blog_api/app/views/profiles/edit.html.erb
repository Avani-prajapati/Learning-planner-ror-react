<h1>Edit Profile</h1>

<%# official guide: multipart must be true for file uploads %>
<%= form_with model: @profile, url: profile_path, method: :patch, multipart: true do |f| %>

  <div>
    <%= f.label :bio %><br>
    <%= f.text_area :bio, rows: 4 %>
  </div>

  <div>
    <%= f.label :avatar, "Profile Image" %><br>
    <%= f.file_field :avatar, accept: "image/*" %>
  </div>

  <% if @profile.avatar.attached? %>
    <p>Current photo:</p>
    <%# official guide: variant with resize_to_limit for transforming images %>
    <%= image_tag @profile.avatar.variant(resize_to_limit: [100, 100]) %>
  <% end %>

  <%= f.submit "Save Profile" %>
<% end %>